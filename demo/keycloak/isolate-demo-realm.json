{
  "realm": "isolate-demo",
  "displayName": "Isolate v2 Docker Demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "groups": [
    {"name": "Demo-DevOps"},
    {"name": "Demo-Developers"},
    {"name": "Demo-DBA"}
  ],
  "clients": [
    {
      "clientId": "isolate-demo",
      "name": "Isolate v2 Docker Demo",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "isolate-demo-secret",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:18081/auth/callback",
        "http://127.0.0.1:18081/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:18081",
        "http://127.0.0.1:18081"
      ],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Demo",
      "email": "alice@example.test",
      "credentials": [
        {"type": "password", "value": "demo123", "temporary": false}
      ],
      "groups": ["/Demo-DevOps"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Demo",
      "email": "bob@example.test",
      "credentials": [
        {"type": "password", "value": "demo123", "temporary": false}
      ],
      "groups": ["/Demo-Developers", "/Demo-DBA"]
    }
  ]
}
