filebeat.inputs:
  - type: filestream
    id: isolate-audit
    paths:
      - /opt/auth/logs/*/*/session.jsonl
      - /opt/auth/spool/audit.jsonl
    parsers:
      - ndjson:
          target: ""
          add_error_key: true

# Configure the approved Elasticsearch/Logstash/OpenSearch-compatible output.
output.logstash:
  hosts: ["logstash.example.org:5044"]
