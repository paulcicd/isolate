{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "secrets",
    "runtime",
    "init",
    "api",
    "gateway",
    "jobs",
    "recordings"
  ],
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
      "maxLength": 253
    },
    "replicas": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "enabled"
      ],
      "properties": {
        "replicas": {
          "$ref": "#/definitions/replicas"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]+$"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/definitions/name"
          }
        }
      }
    },
    "nameOverride": {
      "type": "string",
      "pattern": "^$|^[a-z0-9][a-z0-9-]*$",
      "maxLength": 48
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^$|^[a-z0-9][a-z0-9.-]*$"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "configFile"
      ],
      "properties": {
        "existingSecret": {
          "$ref": "#/definitions/name"
        },
        "configFile": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
          "maxLength": 128
        }
      }
    },
    "init": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingClaim",
        "mountPath",
        "privateSecretsClaim"
      ],
      "properties": {
        "existingClaim": {
          "$ref": "#/definitions/name"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/var/lib/[a-zA-Z0-9_-]+$"
        },
        "privateSecretsClaim": {
          "type": "string",
          "pattern": "^$|^[a-z0-9][a-z0-9.-]*$"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "port",
        "enabled"
      ],
      "properties": {
        "replicas": {
          "$ref": "#/definitions/replicas"
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "sshPort",
        "webPort",
        "sshService",
        "enabled"
      ],
      "properties": {
        "replicas": {
          "$ref": "#/definitions/replicas"
        },
        "sshPort": {
          "$ref": "#/definitions/port"
        },
        "webPort": {
          "$ref": "#/definitions/port"
        },
        "sshService": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "port"
          ],
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "LoadBalancer",
                "NodePort"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "jobs": {
      "$ref": "#/definitions/worker"
    },
    "recordings": {
      "$ref": "#/definitions/worker"
    },
    "resources": {
      "type": "object"
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "$ref": "#/definitions/name"
        },
        "tlsSecret": {
          "$ref": "#/definitions/name"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "gatewayAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "acknowledgement": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "webApplications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "hosts",
        "className",
        "annotations"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "tlsSecret"
            ],
            "properties": {
              "host": {
                "$ref": "#/definitions/name"
              },
              "tlsSecret": {
                "$ref": "#/definitions/name"
              }
            }
          }
        }
      }
    }
  }
}
